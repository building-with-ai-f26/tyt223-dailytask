# Copy this file to .env and fill in your values (Windows: copy .env.example .env)
# NEVER commit your actual .env file to Git! It is already listed in .gitignore.

# Optional AI typing suggestions, used only by `node server.js` on your own computer.
# Your key from platform.openai.com -> API keys
OPENAI_API_KEY=sk-replace-with-your-key
# A fast, low-cost model; run `node server.js --models` to list the ones your key can use
OPENAI_MODEL=
# Safety cap on AI requests per day
AI_DAILY_LIMIT=300

# Push notification keys for reminders. These are NOT read by the app: copy them into
# Supabase -> Edge Functions -> Secrets. The public key also goes in docs/app/index.html (PUSH_PUBLIC_KEY).
VAPID_PUBLIC_KEY=replace-with-public-key
VAPID_PRIVATE_KEY=replace-with-private-key
VAPID_SUBJECT=https://building-with-ai-f26.github.io/tyt223-dailytask/
